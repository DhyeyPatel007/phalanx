# PHALANX — copy to .env.local, never commit real values

# PayPal Sandbox (server only — needed for live disputes, seeded demo works without them)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Provider Configuration (defaults to gemini; seeded demo works without any key)
# Supported providers: gemini | openai | grok | deepseek | kimi | groq | nvidia | custom
LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-3.8-flash, gpt-4o-mini, grok-4, deepseek-chat, kimi-k2.5, llama-3.3-70b-versatile, nvidia/llama-3.1-nemotron-70b-instruct)
LLM_MODEL=

# Provider API Keys (configure the one matching LLM_PROVIDER, or use LLM_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
# Key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# Custom / Universal OpenAI-compatible endpoint (used if LLM_PROVIDER=custom, or overrides)
LLM_BASE_URL=
LLM_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
